# Claude API (챗봇)
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend (이메일 발송)
# https://resend.com/api-keys 에서 발급
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 인증이 완료된 발신 도메인과 실제 문의 수신함
RESEND_FROM_EMAIL=Jabin Studio <inquiry@jabin.studio>
RESEND_TO_EMAIL=hello@jabin.studio

# Google Tag Manager (운영 도메인에서만 로드, 미설정 시 GTM-KPW4GPCG 사용)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# 로컬에서 이벤트 payload만 콘솔로 확인할 때 true
NEXT_PUBLIC_ANALYTICS_DEBUG=false
